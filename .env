# ── Proyecto ──
PROJECT_NAME=V0x3l
PROJECT_VERSION=1.0.0

# ── Sistema ──
UBUNTU_MIN_VERSION=24
INSTALL_DIR_PREFIX=.local/share

# ── Rutas de archivos runtime ──
LOG_FILE=/tmp/v0x3l.log
CHECKPOINT_FILE=/tmp/v0x3l-progress

# ── Configuraciones del sistema ──
TLP_CONF_NAME=01-v0x3l.conf
PLYMOUTH_THEME_NAME=v0x3l-boot-theme

# ── Repositorio ──
REPO_URL=https://github.com/alexandrpunk/V0x3l.git
REPO_BRANCH=refactor
